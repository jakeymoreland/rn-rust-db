{
  "name": "@rn-experiments/reconcile-engine",
  "version": "0.1.0",
  "description": "On-device reconciler for multi-source data in React Native: merges the same record arriving from several feeds field-by-field (timestamp then priority), over a Rust/SQLite core with a redis-style kv, pub/sub, and zero-copy JSI queries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakeymoreland/rn-rust-db.git",
    "directory": "packages/reconcile-engine"
  },
  "homepage": "https://github.com/jakeymoreland/rn-rust-db#readme",
  "bugs": "https://github.com/jakeymoreland/rn-rust-db/issues",
  "//private": "Stays private until the native-artifact distribution question in ROADMAP.md is settled — publishing today would ship a package with no prebuilt binaries.",
  "private": true,
  "main": "src/index.ts",
  "files": [
    "src",
    "cpp",
    "ios",
    "ios-rust",
    "android",
    "android-rust",
    "scripts",
    "react-native.config.js",
    "ReconcileEngine.podspec"
  ],
  "scripts": {
    "test": "jest",
    "check-artifacts": "bash scripts/check-artifacts.sh"
  },
  "peerDependencies": {
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "codegenConfig": {
    "name": "ReconcileEngineSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnexperiments.reconcileengine"
    },
    "ios": {
      "modulesProvider": {
        "NativeReconcileEngine": "ReconcileEngineProvider"
      }
    }
  }
}
